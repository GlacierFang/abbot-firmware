### pio 版本
PlatformIO Core, version 6.1.18

### platformio.ini
; abbot ESP32-S3 固件 —— 板级构建参数
; 强制约束来源: abbot/doc/02-硬件抽象层与底层驱动契约.md §一
;   改动本文件前必须先读 doc/02 §一, 三条强制值一个字都不能少。

[env:esp32s3]
; 钉 espressif32@6.9.0 —— 与 eink-mini 已验证组合一致（platformio 6.1.18 + espressif32 6.9.0），
; 且该版本的 Arduino core 2.x 自带 mbedtls 2.16（net_client.c 的兼容层按此编写）。
platform = espressif32@6.9.0
board = esp32-s3-devkitc-1
framework = arduino

; 强制: 8 线 OPI PSRAM。不写这行 8MB PSRAM 认不出来, 字库与 LVGL 缓冲区直接爆。
board_build.arduino.memory_type = qio_opi
; 强制: 为字库 / LVGL 缓冲区 / 网络协议栈留足程序空间。
board_build.partitions = huge_app.csv
board_build.flash_mode = qio
board_upload.flash_size = 16MB

monitor_speed = 115200
monitor_filters = esp32_exception_decoder, time

build_flags =
    -Wall
    -Wextra
    -Werror
    ; 第三方库 (LovyanGFX / LVGL) 的警告不归我们管, 但它们自己的 build_flags
    ; 会被 PlatformIO 追加在后面, 所以这里对库目录单独放宽:
    ; PlatformIO 的 -I 顺序决定库源码走哪套 flag, 用 lib_deps 的 srcFilter
    ; 配合 build_unflags 无法区分, 故改为对库不启用 -Werror (见下方 lib_ignore / lib_extra).
    -D CORE_DEBUG_LEVEL=1
    -D ARDUINO_USB_MODE=1
    -D ARDUINO_USB_CDC_ON_BOOT=1
    -D BOARD_HAS_PSRAM
    ; LVGL 8.x 找配置的两种方式: 默认用 `#include "../../lv_conf.h"`（要求配置
    ; 放在 lvgl 目录同级）；定义 LV_CONF_INCLUDE_SIMPLE 后改用 `#include "lv_conf.h"`，
    ; 只需把配置目录加进 include path —— 本文件在 include/ 下, 已在路径里。
    -D LV_CONF_INCLUDE_SIMPLE
    -I include
    -I src
    ; 摄像头驱动 (esp32-camera) 在 Arduino ESP32 SDK 里是**预编译静态库**
    ; (tools/sdk/esp32s3/lib/libesp32-camera.a), 而 PlatformIO 的 arduino builder
    ; 不会自动加它的头文件路径和链接项 —— 必须显式补上, 否则 #include "esp_camera.h"
    ; 直接找不到头文件。头文件在 tools/sdk/esp32s3/include/esp32-camera/{driver,conversions}/include。
    -I$PROJECT_PACKAGE_DIR/framework-arduinoespressif32/tools/sdk/esp32s3/include/esp32-camera/driver/include
    -I$PROJECT_PACKAGE_DIR/framework-arduinoespressif32/tools/sdk/esp32s3/include/esp32-camera/conversions/include
    -L$PROJECT_PACKAGE_DIR/framework-arduinoespressif32/tools/sdk/esp32s3/lib
    -lesp32-camera

lib_deps =
    ; doc/02 §3.1 强制用 LovyanGFX（DMA 刷新效率高于 TFT_eSPI）
    lovyan03/LovyanGFX@^1.1.16
    lvgl/lvgl@^8.3.11

