### pio 版本
PlatformIO Core, version 6.1.18

### platformio.ini
; abbot ESP32-S3 固件 —— 板级构建参数
; 强制约束来源: abbot/doc/02-硬件抽象层与底层驱动契约.md §一
;   改动本文件前必须先读 doc/02 §一, 三条强制值一个字都不能少。

[env:esp32s3]
; 钉 espressif32@6.9.0 —— 与 eink-mini 已验证组合一致（platformio 6.1.18 + espressif32 6.9.0），
; 且该版本的 Arduino core 2.x 自带 mbedtls 2.16（net_client.c 的兼容层按此编写）。
platform = espressif32@6.9.0
board = esp32-s3-devkitc-1
framework = arduino

; 强制: 8 线 OPI PSRAM。不写这行 8MB PSRAM 认不出来, 字库与 LVGL 缓冲区直接爆。
board_build.arduino.memory_type = qio_opi
; 强制: 为字库 / LVGL 缓冲区 / 网络协议栈留足程序空间。
board_build.partitions = huge_app.csv
board_build.flash_mode = qio
board_upload.flash_size = 16MB

monitor_speed = 115200
monitor_filters = esp32_exception_decoder, time

build_flags =
    -Wall
    -Wextra
    -Werror
    -D CORE_DEBUG_LEVEL=1
    -D ARDUINO_USB_MODE=1
    -D ARDUINO_USB_CDC_ON_BOOT=1
    -D BOARD_HAS_PSRAM
    -I include
    -I src

lib_deps =
    ; doc/02 §3.1 强制用 LovyanGFX（DMA 刷新效率高于 TFT_eSPI）
    lovyan03/LovyanGFX@^1.1.16
    lvgl/lvgl@^8.3.11

; 主机侧桩测试不参与设备固件编译。
[env:native]
platform = native
build_flags = -I include -I src -I test
test_framework = unity

